# === Подключение ===
# user-token аккаунта Discord (НЕ bot-token!).
# ВНИМАНИЕ: использование user-token'а нарушает ToS Discord — аккаунт может быть заблокирован.
DISCORD_TOKEN=your_user_token_here

# id целевого текстового канала, из которого собираем данные
CHANNEL_ID=1234567890123456789

# === Дата начала сбора ===
# Собирать сообщения только с этой даты (UTC). Сообщения старше — игнорируются,
# а история до этой даты даже не запрашивается у API (snowflake-курсор).
# Формат: 2024-01-01 или "2024-01-01 12:30" или ISO8601 с зоной (2024-01-01T00:00:00+03:00).
# Пусто / 0 / all -> собирать всю историю канала.
START_DATE=2024-01-01

# === Периодичность сбора ===
# Пауза МЕЖДУ обходами канала, сек. Порядок: при запуске проверка выполняется
# сразу (после backfill — тоже сразу), затем «обход завершён -> ждём этот
# интервал -> новый обход». 300 = 5 минут.
POLL_INTERVAL_SEC=300
# Максимум сообщений за один history-запрос (до 100)
FETCH_LIMIT=100

# === Сырой JSON сообщений (messages.raw_json) ===
# По умолчанию 0: полный дамп Discord-объектов каждого сообщения НЕ пишется в
# БД (раздувает базу в разы; все нужные поля уже смаплены в колонки).
# При первом запуске после обновления миграция v4 очистит старые дампы и
# сделает бэкап БД в data/backup_pre_v4_<timestamp>.db.
# 1 — хранить raw_json для новых сообщений (например, для будущих полей).
STORE_RAW_JSON=0

# === Human-like pacing (имитация живого пользователя) ===
# Случайная задержка между запросами к API, сек
REQUEST_DELAY_MIN=2.5
REQUEST_DELAY_MAX=7.0

# === Вложения (картинки) ===
# Скачивание картинок на диск ВЫКЛЮЧЕНО по умолчанию.
# Включается ТОЛЬКО явным DOWNLOAD_ATTACHMENTS=1 (или true/yes/on).
# 0 / пусто / строка отсутствует -> в БД сохраняются только метаданные (url, sha256, размер),
# файлы не загружаются — этого достаточно для текстового анализа личности.
DOWNLOAD_ATTACHMENTS=0
# Каталог для файлов (создаётся только при DOWNLOAD_ATTACHMENTS=1)
ATTACHMENTS_DIR=data/attachments

# === База данных ===
DATABASE_URL=sqlite:///data/profiling.db

# === Выгрузка для нейросети (export_profiles.py читает эти настройки сам) ===
# Максимум СТРОК ЧАТА в транскрипте на пользователя. Берутся самые СВЕЖИЕ
# строки (срез от нового к старому); строки текста НЕ обрезаются посередине.
# Нужно, чтобы файл промпта не превышал лимиты бесплатной модели.
# 0 / пусто -> полная лента без среза. Переопределяется флагом --max-lines N.
EXPORT_MAX_LINES=300
# Окно временной связности диалога (сек) — насколько близко должны стоять
# реплики собеседников, чтобы попасть в контекст. Переопределяется --context-window.
EXPORT_CONTEXT_WINDOW=120

# === Логи ===
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Админка (admin_app.py) ---
# Пароль для входа в веб-админку (обязателен, иначе админка не стартует).
ADMIN_PASSWORD=change_me_admin
# Подпись сессий (если пусто — выводится из ADMIN_PASSWORD; лучше задать свою длинную строку).
SECRET_KEY=
# Столбцы, добавляемые в ленты таблиц админки поверх набора по умолчанию
# (формат "таблица:столбец" через запятую). Пусто = используются VIEW_COLUMNS из admin_app.py.
ADMIN_EXTRA_COLUMNS=
# Столбцы, скрываемые из лент таблиц админка (формат "таблица:столбец" через запятую).
# Сокрытые поля остаются доступны на странице записи (редактирование).
ADMIN_HIDE_COLUMNS=

# --- Модель для анализа выгруженных «дел» (подсказка export_profiles.py) ---
# Имя LLM, которой скармливаются out/prompts/*.md. Заводится в .env, чтобы скрипты
# автоанализа брали модель отсюда. Бесплатные API-варианты:
#   openrouter:deepseek/deepseek-chat-v3.1:free  (DeepSeek через OpenRouter)
#   openrouter:qwen/qwen3-coder:free             (Qwen через OpenRouter)
#   groq:llama-3.3-70b-versatile                 (Groq, бесплатно, быстрый)
ANALYSIS_MODEL=openrouter:deepseek/deepseek-chat-v3.1:free
