# === Подключение ===
# user-token аккаунта Discord (НЕ bot-token!).
# ВНИМАНИЕ: использование user-token'а нарушает ToS Discord — аккаунт может быть заблокирован.
DISCORD_TOKEN=your_user_token_here

# id целевого текстового канала, из которого собираем данные
CHANNEL_ID=1234567890123456789

# === Дата начала сбора ===
# Собирать сообщения только с этой даты (UTC). Сообщения старше — игнорируются,
# а история до этой даты даже не запрашивается у API (snowflake-курсор).
# Формат: 2024-01-01 или "2024-01-01 12:30" или ISO8601 с зоной (2024-01-01T00:00:00+03:00).
# Пусто / 0 / all -> собирать всю историю канала.
START_DATE=2024-01-01

# === Периодичность сбора ===
# Интервал опроса канала на новые сообщения, сек
POLL_INTERVAL_SEC=300
# Максимум сообщений за один history-запрос (до 100)
FETCH_LIMIT=100

# === Human-like pacing (имитация живого пользователя) ===
# Случайная задержка между запросами к API, сек
REQUEST_DELAY_MIN=2.5
REQUEST_DELAY_MAX=7.0

# === Вложения (картинки) ===
# Скачивание картинок на диск ВЫКЛЮЧЕНО по умолчанию.
# Включается ТОЛЬКО явным DOWNLOAD_ATTACHMENTS=1 (или true/yes/on).
# 0 / пусто / строка отсутствует -> в БД сохраняются только метаданные (url, sha256, размер),
# файлы не загружаются — этого достаточно для текстового анализа личности.
DOWNLOAD_ATTACHMENTS=0
# Каталог для файлов (создаётся только при DOWNLOAD_ATTACHMENTS=1)
ATTACHMENTS_DIR=data/attachments

# === База данных ===
DATABASE_URL=sqlite:///data/profiling.db

# === Логи ===
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
