# Discord user-token аккаунта, от имени которого работает сборщик.
# ВНИМАНИЕ: использование user-token нарушает ToS Discord — используйте только свой аккаунт и на свой риск.
DISCORD_TOKEN=your_user_token_here

# ID целевого текстового канала (Snowflake). Правой кнопкой по каналу -> Копировать ID (нужен Developer Mode).
CHANNEL_ID=0000000000000000000

# Дата начала сбора (UTC). История ДО этой даты не запрашивается и не сохраняется.
# Форматы: 2024-06-01 | "2024-06-01 12:30" | 2024-05-31T00:00:00+03:00
# Пусто / 0 / all — собирать всю историю канала.
START_DATE=

# Интервал периодического опроса канала, сек (между запросами добавляется человеческий джиттер).
POLL_INTERVAL=300

# Максимум сообщений за одну страницу истории (не более 100).
HISTORY_BATCH=50

# Путь к файлу SQLite.
DB_PATH=data/profiler.db

# Каталог для скачанных вложений (картинки и т.д.).
MEDIA_DIR=data/media

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
